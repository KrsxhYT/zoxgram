// Zoxgram profile notes. The trusted getOrCreateZoxId callable assigns the
// six-digit ID and adds the zox_id Firebase Auth custom claim.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsZoxId(zoxId) {
      return signedIn()
        && request.auth.token.zox_id is string
        && request.auth.token.zox_id == zoxId
        && zoxId.matches('^[0-9]{6}$');
    }

    match /profiles/{zoxId} {
      // The owner record is private too; ZoxIDs are not a public directory.
      allow read: if ownsZoxId(zoxId);
      allow create, update: if ownsZoxId(zoxId)
        && request.resource.data.keys().hasAll(['zoxId'])
        && request.resource.data.keys().hasOnly(['zoxId'])
        && request.resource.data.zoxId == zoxId;
      allow delete: if false;

      // One document per Telegram user being noted:
      // profiles/{ownerZoxId}/notes/{contactTelegramUserId}
      match /notes/{contactUserId} {
        function validNote() {
          return contactUserId.matches('^[1-9][0-9]{0,19}$')
            && request.resource.data.keys().hasOnly([
                'text', 'expiryOption', 'expiresAt', 'updatedAt'
              ])
            && request.resource.data.keys().hasAll([
              'text', 'expiryOption', 'expiresAt', 'updatedAt'
            ])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1200
            && request.resource.data.expiryOption in ['1d', '5d', '7d', 'never']
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.updatedAt == request.time
            && (
              request.resource.data.expiryOption == 'never'
                ? request.resource.data.expiresAt == null
                : request.resource.data.expiresAt is timestamp
                  && request.resource.data.expiresAt > request.time
            );
        }

        allow read: if ownsZoxId(zoxId);
        allow create, update: if ownsZoxId(zoxId) && validNote();
        allow delete: if ownsZoxId(zoxId)
          && contactUserId.matches('^[1-9][0-9]{0,19}$');
      }
    }

    // ZoxID allocation and UID mappings are callable-function-only.
    match /zoxIdClaims/{zoxId} {
      allow read, write: if false;
    }

    match /zoxIdOwners/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
